              "mode": "raw",
              "raw": "{\n  \"amount\": 150.75,\n  \"type\": \"income\",\n  \"category_id\": 1,\n  \"date\": \"2026-11-01\",\n  \"description\": \"Shitje test\"\n}"
            }
          }
        },
